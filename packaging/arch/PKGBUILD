# Maintainer: GASDJUGA
#
# JuTeX (LibreTeX before 2.0.0) from its git tag on GitHub.
# Build and install from packaging/arch with:  makepkg -si
pkgname=jutex
pkgver=1.2.2
pkgrel=1
pkgdesc="Editor de LaTeX local estilo Overleaf (Tauri)"
arch=('x86_64')
url="https://github.com/GASDJUGA/jutex"
license=('GPL-3.0-or-later')
depends=('webkit2gtk-4.1' 'gtk3' 'cairo' 'pango' 'gdk-pixbuf2' 'glib2' 'libsoup3' 'openssl'
         'hicolor-icon-theme')
makedepends=('git' 'cargo' 'nodejs' 'pnpm')
optdepends=('git: respaldo con Git y GitHub'
            'github-cli: listar y crear repositorios de GitHub desde la app'
            'texlive-basic: compilar con el TeX Live de pacman (o instalar el de JuTeX desde la app)'
            'texlive-xetex: XeLaTeX'
            'texlive-langspanish: babel en español'
            'texlive-binextra: latexmk y synctex')
provides=('libretex')
conflicts=('libretex')
replaces=('libretex')
options=('!lto' '!debug')
source=("$pkgname::git+https://github.com/GASDJUGA/jutex.git#tag=v$pkgver")
sha256sums=('SKIP')

prepare() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')" \
    --manifest-path src-tauri/Cargo.toml
  pnpm install --frozen-lockfile
}

build() {
  cd "$pkgname"
  export CARGO_HOME="$srcdir/cargo-home"
  # No build paths inside the binary.
  export RUSTFLAGS="${RUSTFLAGS:-} --remap-path-prefix=$srcdir=/usr/src/$pkgname"
  # The .deb bundle has the layout Tauri expects at run time (/usr/lib/JuTeX for the
  # templates); its contents are installed below.
  pnpm tauri build --bundles deb
}

package() {
  cd "$pkgname"
  local deb
  deb=$(find src-tauri/target/release/bundle/deb -name '*.deb' | head -n 1)
  bsdtar -xOf "$deb" 'data.tar.*' | bsdtar -xf - -C "$pkgdir"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
